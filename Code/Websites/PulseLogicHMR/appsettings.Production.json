{
  "environment": {
    "isdevelopment": false
  },
  "IsAuditEnable": true,
  "CacheExpirationMinutes": 60,
  "RealTimeRemoteSyncEnabled": false,
  "JwtTokenConfig": {
    "JwtValidMinutes": 480,
    "JwtAudience": "pulselogic-emr-prod",
    "JwtIssuer": "pulselogic-emr-prod"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "PulseLogicHMR": "Information"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
