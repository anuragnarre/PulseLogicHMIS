@using PulseLogicHMR.Security
@inject Wangkanai.Detection.Services.IDetectionService Detection
@model LoginViewModel

@{
    Layout = null;
    string message = (string)ViewData["status"];
    string expiryNotice = (string)ViewData["ExpiryNotice"];
    var deviceType = Detection.Device.Type.ToString().ToLower();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PulseLogic HMIS — Sign In</title>
    <meta name="description" content="Sign in to PulseLogic HMIS v2.0.1 — The Next Generation Hospital Management Information System">
    <link rel="icon" type="image/png" href="~/themes/theme-default/images/pl_logo_light.png" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

    <style type="text/css">
        /* ═══════════════════════════════════════════════════
           THEME SYSTEM — CSS Custom Properties
           All three themes fully cover every UI element
           ═══════════════════════════════════════════════════ */

        /* ── Light ── */
        :root,
        [data-theme="light"] {
            --bg-primary:       #eef2f7;
            --bg-secondary:     #dde4ef;
            --card-bg:          rgba(255, 255, 255, 0.88);
            --card-border:      rgba(226, 232, 240, 0.8);
            --panel-bg:         linear-gradient(145deg, #1e3a5f 0%, #0ea5e9 100%);
            --panel-text:       #ffffff;
            --panel-muted:      rgba(255, 255, 255, 0.75);
            --text-primary:     #0f172a;
            --text-secondary:   #475569;
            --text-muted:       #94a3b8;
            --input-bg:         rgba(248, 250, 252, 0.9);
            --input-border:     #cbd5e1;
            --input-focus-border: #0ea5e9;
            --input-focus-shadow: rgba(14, 165, 233, 0.18);
            --input-text:       #0f172a;
            --input-placeholder: #94a3b8;
            --btn-primary-bg:   linear-gradient(135deg, #0ea5e9, #0284c7);
            --btn-primary-text: #ffffff;
            --btn-primary-shadow: rgba(14, 165, 233, 0.35);
            --accent:           #0ea5e9;
            --accent-2:         #6366f1;
            --orb-1:            rgba(14, 165, 233, 0.18);
            --orb-2:            rgba(99, 102, 241, 0.12);
            --link-color:       #0ea5e9;
            --checkbox-border:  #cbd5e1;
            --shadow-card:      0 20px 60px -10px rgba(0,0,0,0.12);
            --badge-admin-bg:   linear-gradient(135deg, #f43f5e, #be123c);
        }

        /* ── Dark ── */
        [data-theme="dark"] {
            --bg-primary:       #0b1120;
            --bg-secondary:     #0f172a;
            --card-bg:          rgba(30, 41, 59, 0.80);
            --card-border:      rgba(51, 65, 85, 0.7);
            --panel-bg:         linear-gradient(145deg, #020617 0%, #0f172a 100%);
            --panel-text:       #f8fafc;
            --panel-muted:      #94a3b8;
            --text-primary:     #f8fafc;
            --text-secondary:   #cbd5e1;
            --text-muted:       #64748b;
            --input-bg:         rgba(15, 23, 42, 0.85);
            --input-border:     #334155;
            --input-focus-border: #06b6d4;
            --input-focus-shadow: rgba(6, 182, 212, 0.2);
            --input-text:       #f8fafc;
            --input-placeholder: #64748b;
            --btn-primary-bg:   linear-gradient(135deg, #06b6d4, #0891b2);
            --btn-primary-text: #ffffff;
            --btn-primary-shadow: rgba(6, 182, 212, 0.4);
            --accent:           #06b6d4;
            --accent-2:         #818cf8;
            --orb-1:            rgba(6, 182, 212, 0.12);
            --orb-2:            rgba(129, 140, 248, 0.08);
            --link-color:       #38bdf8;
            --checkbox-border:  #334155;
            --shadow-card:      0 25px 80px -15px rgba(0,0,0,0.6);
            --badge-admin-bg:   linear-gradient(135deg, #e11d48, #9f1239);
        }

        /* ── Midnight ── */
        [data-theme="midnight"] {
            --bg-primary:       #030305;
            --bg-secondary:     #09090b;
            --card-bg:          rgba(24, 24, 27, 0.82);
            --card-border:      rgba(39, 39, 42, 0.8);
            --panel-bg:         linear-gradient(145deg, #040407 0%, #18181b 100%);
            --panel-text:       #fafafa;
            --panel-muted:      #a1a1aa;
            --text-primary:     #fafafa;
            --text-secondary:   #d4d4d8;
            --text-muted:       #71717a;
            --input-bg:         rgba(9, 9, 11, 0.9);
            --input-border:     #27272a;
            --input-focus-border: #a855f7;
            --input-focus-shadow: rgba(168, 85, 247, 0.22);
            --input-text:       #fafafa;
            --input-placeholder: #71717a;
            --btn-primary-bg:   linear-gradient(135deg, #a855f7, #9333ea);
            --btn-primary-text: #ffffff;
            --btn-primary-shadow: rgba(168, 85, 247, 0.45);
            --accent:           #a855f7;
            --accent-2:         #ec4899;
            --orb-1:            rgba(168, 85, 247, 0.12);
            --orb-2:            rgba(236, 72, 153, 0.08);
            --link-color:       #c084fc;
            --checkbox-border:  #27272a;
            --shadow-card:      0 25px 80px -15px rgba(0,0,0,0.8);
            --badge-admin-bg:   linear-gradient(135deg, #ec4899, #be185d);
        }

        /* ═══════════════════════════════════════════════════
           THEME-BASED LOGO SWAPPING
           ═══════════════════════════════════════════════════ */
        [data-theme="light"] .brand-logo-icon img,
        [data-theme="light"] .logo-img {
            content: url('/themes/theme-default/images/dark_logo_plain.png');
            filter: none !important;
        }
        [data-theme="dark"] .brand-logo-icon img,
        [data-theme="dark"] .logo-img,
        [data-theme="midnight"] .brand-logo-icon img,
        [data-theme="midnight"] .logo-img {
            content: url('/themes/theme-default/images/light_logo_plain.png');
            filter: none !important;
        }

        /* ═══════════════════════════════════════════════════
           GLOBAL RESET & TYPOGRAPHY
           ═══════════════════════════════════════════════════ */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html {
            height: 100%;
            -webkit-font-smoothing: antialiased;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            transition: background 0.45s ease, color 0.45s ease;
            position: relative;
        }

        /* ═══════════════════════════════════════════════════
           ANIMATED BACKGROUND
           ═══════════════════════════════════════════════════ */
        .bg-canvas {
            position: fixed;
            inset: 0;
            z-index: 0;
            overflow: hidden;
            pointer-events: none;
        }

        /* Large ambient orbs */
        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            animation: orbFloat 12s ease-in-out infinite alternate;
            transition: background 0.5s ease;
        }

        .orb-1 {
            width: 55vw; height: 55vw;
            background: var(--orb-1);
            top: -20%; left: -15%;
            animation-duration: 14s;
        }

        .orb-2 {
            width: 40vw; height: 40vw;
            background: var(--orb-2);
            bottom: -15%; right: -10%;
            animation-duration: 10s;
            animation-delay: -4s;
        }

        .orb-3 {
            width: 28vw; height: 28vw;
            background: var(--orb-1);
            top: 40%; left: 55%;
            animation-duration: 16s;
            animation-delay: -7s;
            opacity: 0.5;
        }

        @@keyframes orbFloat {
            0%   { transform: translate(0, 0) scale(1); }
            50%  { transform: translate(3%, 4%) scale(1.06); }
            100% { transform: translate(-2%, 6%) scale(0.97); }
        }

        /* Subtle animated grid */
        .bg-grid {
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(var(--card-border) 1px, transparent 1px),
                linear-gradient(90deg, var(--card-border) 1px, transparent 1px);
            background-size: 48px 48px;
            opacity: 0.25;
            animation: gridPan 25s linear infinite;
        }

        @@keyframes gridPan {
            0%   { background-position: 0 0, 0 0; }
            100% { background-position: 48px 48px, 48px 48px; }
        }

        /* Floating particles */
        .particle {
            position: absolute;
            border-radius: 50%;
            background: var(--accent);
            opacity: 0;
            animation: particleRise var(--dur, 8s) ease-in var(--delay, 0s) infinite;
        }

        @@keyframes particleRise {
            0%   { opacity: 0; transform: translateY(0) scale(0); }
            10%  { opacity: 0.6; }
            90%  { opacity: 0.15; }
            100% { opacity: 0; transform: translateY(-100vh) scale(1.5); }
        }

        /* ═══════════════════════════════════════════════════
           MAIN CARD
           ═══════════════════════════════════════════════════ */
        .login-card {
            position: relative;
            z-index: 10;
            display: flex;
            width: min(1080px, 94vw);
            min-height: 600px;
            max-height: 96vh;
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 28px;
            box-shadow: var(--shadow-card);
            overflow: hidden;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            /* Entrance animation */
            animation: cardEnter 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
            transition: background 0.45s ease, border-color 0.45s ease, box-shadow 0.45s ease;
        }

        @@keyframes cardEnter {
            from {
                opacity: 0;
                transform: translateY(32px) scale(0.97);
                filter: blur(4px);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
                filter: blur(0);
            }
        }

        /* ═══════════════════════════════════════════════════
           LEFT PANEL — BRANDING
           ═══════════════════════════════════════════════════ */
        .brand-panel {
            flex: 1.1;
            background: var(--panel-bg);
            color: var(--panel-text);
            padding: 3rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
            transition: background 0.45s ease;
        }

        /* Decorative mesh on panel */
        .brand-panel::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255,255,255,0.06) 1px, transparent 1px);
            background-size: 28px 28px;
            pointer-events: none;
        }

        /* Glow accent on panel */
        .brand-panel::after {
            content: '';
            position: absolute;
            bottom: -80px; right: -80px;
            width: 300px; height: 300px;
            border-radius: 50%;
            background: radial-gradient(circle, var(--accent) 0%, transparent 65%);
            opacity: 0.15;
            pointer-events: none;
            animation: panelGlow 6s ease-in-out infinite alternate;
        }

        @@keyframes panelGlow {
            from { transform: scale(0.9); opacity: 0.1; }
            to   { transform: scale(1.1); opacity: 0.2; }
        }

        .brand-header {
            position: relative;
            z-index: 2;
        }

        .brand-logo-row {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 1.8rem;
        }

        .brand-logo-icon {
            width: 52px; height: 52px;
            background: rgba(255,255,255,0.12);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(255,255,255,0.2);
            font-size: 1.5rem;
            color: #fff;
            backdrop-filter: blur(8px);
            animation: iconPulse 3s ease-in-out infinite alternate;
        }

        @@keyframes iconPulse {
            from { box-shadow: 0 0 0 0 rgba(255,255,255,0.15); }
            to   { box-shadow: 0 0 0 12px rgba(255,255,255,0); }
        }

        .brand-name {
            font-family: 'Outfit', sans-serif;
            font-size: 1.3rem;
            font-weight: 700;
            color: #fff;
            letter-spacing: -0.3px;
        }

        .brand-name span {
            opacity: 0.65;
            font-weight: 400;
            font-size: 0.9rem;
            display: block;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .brand-headline {
            font-family: 'Outfit', sans-serif;
            font-size: 2.6rem;
            font-weight: 800;
            line-height: 1.15;
            color: var(--panel-text);
            margin-bottom: 1rem;
            text-shadow: 0 2px 20px rgba(0,0,0,0.2);
        }

        .brand-headline em {
            font-style: normal;
            background: linear-gradient(90deg, #7dd3fc, #a5b4fc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .brand-tagline {
            font-size: 1rem;
            color: var(--panel-muted);
            line-height: 1.6;
            max-width: 320px;
        }

        /* Feature pills */
        .feature-pills {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .feature-pill {
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 12px;
            padding: 0.75rem 1rem;
            font-size: 0.9rem;
            color: var(--panel-text);
            font-weight: 500;
            opacity: 0;
            transform: translateX(-18px);
            animation: pillSlide 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
            transition: background 0.2s ease;
        }

        .feature-pill:hover {
            background: rgba(255,255,255,0.14);
        }

        .feature-pill:nth-child(1) { animation-delay: 0.4s; }
        .feature-pill:nth-child(2) { animation-delay: 0.55s; }
        .feature-pill:nth-child(3) { animation-delay: 0.7s; }
        .feature-pill:nth-child(4) { animation-delay: 0.85s; }

        @@keyframes pillSlide {
            to { opacity: 1; transform: translateX(0); }
        }

        .pill-icon {
            width: 34px; height: 34px;
            border-radius: 9px;
            background: rgba(255,255,255,0.12);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
            color: #fff;
            flex-shrink: 0;
        }

        .brand-footer {
            position: relative;
            z-index: 2;
            font-size: 0.8rem;
            color: var(--panel-muted);
        }

        .brand-footer a {
            color: rgba(255,255,255,0.6);
            text-decoration: none;
            transition: color 0.2s;
        }

        .brand-footer a:hover {
            color: #fff;
        }

        /* ═══════════════════════════════════════════════════
           RIGHT PANEL — FORM
           ═══════════════════════════════════════════════════ */
        .form-panel {
            flex: 1;
            padding: 3.5rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            overflow-y: auto;
        }

        /* Form logo */
        .form-logo {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            margin-bottom: 2.5rem;
        }

        .logo-img-wrap {
            width: 68px; height: 68px;
            border-radius: 18px;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 24px -4px var(--btn-primary-shadow);
            transition: box-shadow 0.35s ease, background 0.45s ease;
        }

        .logo-img {
            width: 48px; height: 48px;
            object-fit: contain;
            border-radius: 10px;
            filter: brightness(0) invert(1);
            transition: filter 0.35s ease;
        }

        [data-theme="light"] .logo-img {
            filter: brightness(0) invert(1);
        }

        .logo-wordmark {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .logo-name {
            font-family: 'Outfit', sans-serif;
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--accent);
            letter-spacing: -0.5px;
            transition: color 0.45s ease;
        }

        .logo-tag {
            font-size: 0.65rem;
            font-weight: 600;
            color: var(--text-muted);
            letter-spacing: 3px;
            text-transform: uppercase;
            transition: color 0.45s ease;
        }

        /* Form heading */
        .form-heading {
            text-align: center;
            margin-bottom: 2.2rem;
        }

        .form-heading h2 {
            font-family: 'Outfit', sans-serif;
            font-size: 1.9rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 0.4rem;
            transition: color 0.45s ease;
        }

        .form-heading p {
            font-size: 0.92rem;
            color: var(--text-muted);
            transition: color 0.45s ease;
        }

        /* Floating label inputs */
        .input-group-float {
            position: relative;
            margin-bottom: 1.4rem;
        }

        .input-group-float .field-icon {
            position: absolute;
            left: 1.1rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 1rem;
            pointer-events: none;
            transition: color 0.3s ease;
            z-index: 2;
        }

        .form-input {
            width: 100%;
            height: 52px;
            background: var(--input-bg);
            border: 1.5px solid var(--input-border);
            border-radius: 13px;
            padding: 0 1.2rem 0 3rem;
            font-size: 0.97rem;
            color: var(--input-text);
            font-family: 'Inter', sans-serif;
            transition: border-color 0.25s ease, box-shadow 0.25s ease, background 0.45s ease, color 0.45s ease;
            outline: none;
        }

        .form-input::placeholder {
            color: var(--input-placeholder);
            transition: color 0.45s ease;
        }

        .form-input:focus {
            border-color: var(--input-focus-border);
            box-shadow: 0 0 0 4px var(--input-focus-shadow);
            background: var(--input-bg);
        }

        .form-input:focus + .field-icon {
            color: var(--accent);
        }

        /* Password toggle */
        .pwd-toggle {
            position: absolute;
            right: 1.1rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-muted);
            font-size: 1rem;
            padding: 0;
            transition: color 0.2s;
            z-index: 2;
        }

        .pwd-toggle:hover {
            color: var(--accent);
        }

        /* Options row */
        .options-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.8rem;
            font-size: 0.88rem;
        }

        .checkbox-label {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            color: var(--text-secondary);
            user-select: none;
            transition: color 0.45s ease;
        }

        .checkbox-label input { display: none; }

        .custom-checkbox {
            width: 18px; height: 18px;
            border: 1.5px solid var(--checkbox-border);
            border-radius: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            flex-shrink: 0;
        }

        .checkbox-label input:checked + .custom-checkbox {
            background: var(--accent);
            border-color: var(--accent);
        }

        .custom-checkbox::after {
            content: '\f00c';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            color: white;
            font-size: 9px;
            opacity: 0;
            transform: scale(0);
            transition: all 0.2s ease;
        }

        .checkbox-label input:checked + .custom-checkbox::after {
            opacity: 1; transform: scale(1);
        }

        .forgot-link {
            color: var(--link-color);
            text-decoration: none;
            font-weight: 500;
            font-size: 0.88rem;
            transition: opacity 0.2s ease, color 0.45s ease;
        }

        .forgot-link:hover { opacity: 0.75; }

        /* Submit button */
        .btn-submit {
            width: 100%;
            height: 52px;
            background: var(--btn-primary-bg);
            color: var(--btn-primary-text);
            border: none;
            border-radius: 13px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            font-family: 'Inter', sans-serif;
            position: relative;
            overflow: hidden;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            letter-spacing: 0.3px;
        }

        .btn-submit::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0.15), transparent);
            transition: opacity 0.2s;
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 28px -6px var(--btn-primary-shadow);
        }

        .btn-submit:active { transform: translateY(0); }

        /* Ripple on click */
        .btn-ripple {
            position: absolute;
            border-radius: 50%;
            background: rgba(255,255,255,0.3);
            transform: scale(0);
            animation: btnRipple 0.5s linear;
            pointer-events: none;
        }

        @@keyframes btnRipple {
            to { transform: scale(4); opacity: 0; }
        }

        /* Admin mode */
        body.admin-mode .btn-submit {
            background: var(--badge-admin-bg) !important;
            box-shadow: 0 12px 28px -6px rgba(244,63,94,0.4);
        }

        .admin-banner {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0;
            background: var(--badge-admin-bg);
            color: #fff;
            text-align: center;
            padding: 0.55rem 1rem;
            font-size: 0.82rem;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            z-index: 200;
            animation: bannerSlideDown 0.4s cubic-bezier(0.22, 1, 0.36, 1);
        }

        @@keyframes bannerSlideDown {
            from { transform: translateY(-100%); }
            to   { transform: translateY(0); }
        }

        body.admin-mode .admin-banner { display: block; }

        /* Alerts */
        .alert {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0.9rem 1.1rem;
            border-radius: 12px;
            margin-bottom: 1.5rem;
            font-size: 0.9rem;
            font-weight: 500;
            animation: alertIn 0.35s cubic-bezier(0.22, 1, 0.36, 1);
        }

        @@keyframes alertIn {
            from { opacity: 0; transform: translateY(-8px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .alert-error {
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.25);
        }

        .alert-success {
            background: rgba(16, 185, 129, 0.1);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.25);
        }

        .alert-warning {
            background: rgba(245, 158, 11, 0.1);
            color: #f59e0b;
            border: 1px solid rgba(245, 158, 11, 0.25);
        }

        /* ═══════════════════════════════════════════════════
           THEME SWITCHER
           ═══════════════════════════════════════════════════ */
        .theme-switcher {
            position: fixed;
            top: 1.4rem;
            right: 1.4rem;
            z-index: 100;
            display: flex;
            align-items: center;
            gap: 6px;
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 50px;
            padding: 6px 10px;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            box-shadow: 0 4px 16px rgba(0,0,0,0.12);
            transition: background 0.45s ease, border-color 0.45s ease;
        }

        .switcher-label {
            font-size: 0.72rem;
            font-weight: 600;
            color: var(--text-muted);
            letter-spacing: 0.5px;
            padding-right: 4px;
            white-space: nowrap;
            transition: color 0.45s ease;
        }

        .theme-dot {
            width: 22px; height: 22px;
            border-radius: 50%;
            border: 2px solid transparent;
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
            position: relative;
        }

        .theme-dot:hover { transform: scale(1.2); }

        .theme-dot.active {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--input-focus-shadow);
        }

        .theme-dot-light    { background: linear-gradient(135deg, #e0e7ef, #fff); box-shadow: inset 0 0 0 1px #cbd5e1; }
        .theme-dot-dark     { background: linear-gradient(135deg, #0f172a, #1e293b); box-shadow: inset 0 0 0 1px #334155; }
        .theme-dot-midnight { background: linear-gradient(135deg, #09090b, #3b0764); box-shadow: inset 0 0 0 1px #a855f7; }

        .theme-dot::after {
            content: attr(data-tooltip);
            position: absolute;
            bottom: calc(100% + 6px);
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0,0,0,0.75);
            color: #fff;
            font-size: 0.68rem;
            font-weight: 500;
            padding: 3px 7px;
            border-radius: 6px;
            white-space: nowrap;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.15s ease;
        }

        .theme-dot:hover::after { opacity: 1; }

        /* ═══════════════════════════════════════════════════
           FULL-SCREEN LOADING OVERLAY
           ═══════════════════════════════════════════════════ */
        #login-loader {
            position: fixed;
            inset: 0;
            background: var(--bg-primary);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 500;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease, background 0.45s ease;
        }

        #login-loader.active {
            opacity: 1;
            pointer-events: all;
        }

        .loader-logo {
            width: 80px; height: 80px;
            border-radius: 22px;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: #fff;
            margin-bottom: 2rem;
            animation: loaderLogoPulse 1.5s ease-in-out infinite alternate;
            box-shadow: 0 0 0 0 var(--btn-primary-shadow);
        }

        @@keyframes loaderLogoPulse {
            from { box-shadow: 0 0 0 0 var(--btn-primary-shadow); transform: scale(1); }
            to   { box-shadow: 0 0 0 20px rgba(0,0,0,0); transform: scale(1.05); }
        }

        /* Heartbeat ECG line */
        .ecg-container {
            width: 220px;
            overflow: hidden;
            margin-bottom: 1.5rem;
        }

        .ecg-svg {
            width: 440px;
            height: 50px;
            animation: ecgScroll 1.8s linear infinite;
        }

        @@keyframes ecgScroll {
            from { transform: translateX(0); }
            to   { transform: translateX(-50%); }
        }

        .ecg-path {
            stroke: var(--accent);
            stroke-width: 2.5;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .loader-text {
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--text-secondary);
            letter-spacing: 0.5px;
            transition: color 0.45s ease;
        }

        .loader-dots::after {
            content: '';
            animation: dotCycle 1.5s steps(4, end) infinite;
        }

        @@keyframes dotCycle {
            0%   { content: ''; }
            25%  { content: '.'; }
            50%  { content: '..'; }
            75%  { content: '...'; }
            100% { content: ''; }
        }

        /* Version tag */
        .version-tag {
            position: fixed;
            bottom: 1rem;
            left: 50%;
            transform: translateX(-50%);
            font-size: 0.72rem;
            font-weight: 500;
            color: var(--text-muted);
            letter-spacing: 0.5px;
            z-index: 5;
            transition: color 0.45s ease;
        }

        /* ═══════════════════════════════════════════════════
           RESPONSIVE
           ═══════════════════════════════════════════════════ */
        @@media (max-width: 768px) {
            .brand-panel { display: none; }
            .form-panel { padding: 2rem 1.5rem; justify-content: center; }
            .login-card { width: 100%; border-radius: 0; min-height: 100dvh; max-height: none; box-shadow: none; }
            body { align-items: flex-start; }
            .form-logo { margin-bottom: 2rem; justify-content: center; }
            .form-group input { font-size: 16px; padding: 14px; }
            .btn-login { padding: 14px; font-size: 1.1rem; }
        }
    </style>
</head>
<body class="device-@deviceType">

    <!-- ── Admin Banner ── -->
    <div class="admin-banner" id="adminBanner">
        <i class="fa-solid fa-shield-halved"></i>&nbsp; Administrator Mode Active
    </div>

    <!-- ── Animated Background ── -->
    <div class="bg-canvas">
        <div class="bg-grid"></div>
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
        <!-- Particles (generated by JS below) -->
    </div>

    <!-- ── Theme Switcher ── -->
    <div class="theme-switcher" role="group" aria-label="Theme selector">
        <span class="switcher-label">Theme</span>
        <button class="theme-dot theme-dot-light"    id="tdLight"    data-theme="light"    data-tooltip="Light"    title="Light Theme"    onclick="setTheme('light')"    aria-label="Light theme"></button>
        <button class="theme-dot theme-dot-dark"     id="tdDark"     data-theme="dark"     data-tooltip="Dark"     title="Dark Theme"     onclick="setTheme('dark')"     aria-label="Dark theme"></button>
        <button class="theme-dot theme-dot-midnight" id="tdMidnight" data-theme="midnight" data-tooltip="Midnight" title="Midnight Theme" onclick="setTheme('midnight')" aria-label="Midnight theme"></button>
    </div>

    <!-- ── Full-Screen Loading Overlay ── -->
    <div id="login-loader" role="status" aria-live="polite" aria-label="Signing in…">
        <div class="loader-logo">
            <i class="fa-solid fa-heartbeat"></i>
        </div>
        <div class="ecg-container">
            <svg class="ecg-svg" viewBox="0 0 440 50" xmlns="http://www.w3.org/2000/svg">
                <path class="ecg-path" d="M0,25 L30,25 L40,25 L50,5 L60,45 L70,20 L80,25 L120,25 L130,25 L140,5 L150,45 L160,20 L170,25 L220,25 L230,25 L240,5 L250,45 L260,20 L270,25 L310,25 L320,25 L330,5 L340,45 L350,20 L360,25 L400,25 L410,25 L420,5 L430,45 L440,20" />
            </svg>
        </div>
        <p class="loader-text">Authenticating<span class="loader-dots"></span></p>
    </div>

    <!-- ── Main Login Card ── -->
    <div class="login-card" id="loginCard">

        <!-- Left: Branding Panel -->
        <div class="brand-panel">
            <div class="brand-header">
                <div class="brand-logo-row">
                    <div class="brand-logo-icon">
                        <img src="~/themes/theme-default/images/light_logo_plain.png" alt="PulseLogic Logo" style="width: 38px; object-fit: contain; filter: brightness(0) invert(1);" />
                    </div>
                    <div class="brand-name">
                        PulseLogic HMIS
                        <span>v2.0.1</span>
                    </div>
                </div>
                <h1 class="brand-headline">
                    The <em>Next Generation</em><br>Hospital Platform
                </h1>
                <p class="brand-tagline">
                    A unified clinical &amp; administrative ecosystem built for modern healthcare.
                </p>
            </div>

            <ul class="feature-pills" style="list-style:none;">
                <li class="feature-pill">
                    <span class="pill-icon"><i class="fa-solid fa-laptop-medical"></i></span>
                    Unified HMIS &amp; ERP Platform
                </li>
                <li class="feature-pill">
                    <span class="pill-icon"><i class="fa-solid fa-network-wired"></i></span>
                    Health Information Exchange
                </li>
                <li class="feature-pill">
                    <span class="pill-icon"><i class="fa-solid fa-chart-line"></i></span>
                    Real-time Syndromic Surveillance
                </li>
                <li class="feature-pill">
                    <span class="pill-icon"><i class="fa-solid fa-user-shield"></i></span>
                    HIPAA-Ready Patient Portal
                </li>
            </ul>

            <div class="brand-footer">
                &copy; 2026 PulseLogic Health. All rights reserved.<br>
                <a href="#">Terms &amp; Conditions</a> &nbsp;&middot;&nbsp; <a href="#">Privacy Policy</a>
            </div>
        </div>

        <!-- Right: Form Panel -->
        <div class="form-panel">
            <div class="form-logo">
                <div class="logo-img-wrap">
                    <img class="logo-img"
                         src="~/themes/theme-default/images/light_logo_plain.png"
                         alt="PulseLogic Logo">
                </div>
                <div class="logo-wordmark">
                    <span class="logo-name">PulseLogic</span>
                    <span class="logo-tag">HMIS Platform</span>
                </div>
            </div>

            <div class="form-heading">
                <h2>Welcome Back</h2>
                <p>Sign in to your account to continue</p>
            </div>

            @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { id = "loginForm" }))
            {
                if (message == "login-failed")
                {
                    <div class="alert alert-error">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        Invalid credentials. Please try again.
                    </div>
                }
                else if (message == "logout-success")
                {
                    <div class="alert alert-success">
                        <i class="fa-solid fa-circle-check"></i>
                        You've been logged out successfully.
                    </div>
                }
                else if (message == "user-inactive")
                {
                    <div class="alert alert-error">
                        <i class="fa-solid fa-user-lock"></i>
                        Account deactivated. Please contact your administrator.
                    </div>
                }

                if (!string.IsNullOrEmpty(expiryNotice))
                {
                    <div class="alert alert-warning">
                        <i class="fa-solid fa-clock"></i>
                        @expiryNotice
                    </div>
                }

                <div class="input-group-float">
                    <input class="form-input" name="Username" required type="text"
                           id="username_id" placeholder="Username" autocomplete="username" />
                    <i class="fa-solid fa-user field-icon"></i>
                </div>

                <div class="input-group-float">
                    <input class="form-input" name="password" required type="password"
                           id="password" placeholder="Password" autocomplete="current-password" />
                    <i class="fa-solid fa-lock field-icon"></i>
                    <button type="button" class="pwd-toggle" id="pwdToggle" aria-label="Toggle password visibility">
                        <i class="fa-solid fa-eye" id="pwdToggleIcon"></i>
                    </button>
                </div>

                <div class="options-row">
                    <label class="checkbox-label">
                        @Html.CheckBoxFor(x => x.RememberMe)
                        <div class="custom-checkbox"></div>
                        Remember me
                    </label>
                    <a href="@Url.Action("ForgotPassword","Account")" class="forgot-link">Forgot Password?</a>
                </div>

                <button type="submit" class="btn-submit" id="submitBtn">
                    <span id="submitLabel">Sign In</span>
                    <i class="fa-solid fa-arrow-right" id="submitIcon"></i>
                </button>
            }
        </div>
    </div>

    <!-- Version tag -->
    <div class="version-tag">PulseLogic HMIS v2.0.1 &nbsp;|&nbsp; Powered by PulseLogic Health</div>

    <script>
        /* ══════════════════════════════════════
           THEME ENGINE
           ══════════════════════════════════════ */
        function setTheme(theme) {
            document.documentElement.setAttribute('data-theme', theme);
            localStorage.setItem('pulselogic_theme', theme);
            // Sync active dot
            document.querySelectorAll('.theme-dot').forEach(function(d) {
                d.classList.toggle('active', d.dataset.theme === theme);
            });
            // Fire event for the main app shell
            window.dispatchEvent(new CustomEvent('pulselogic-theme-change', { detail: { theme: theme } }));
        }

        // Apply saved theme BEFORE paint (in <head> ideally, but here too)
        (function() {
            var t = localStorage.getItem('pulselogic_theme') || 'dark';
            document.documentElement.setAttribute('data-theme', t);
            // Mark active dot after DOM ready
            document.addEventListener('DOMContentLoaded', function() {
                document.querySelectorAll('.theme-dot').forEach(function(d) {
                    d.classList.toggle('active', d.dataset.theme === t);
                });
            });
        })();

        /* ══════════════════════════════════════
           PARTICLES
           ══════════════════════════════════════ */
        document.addEventListener('DOMContentLoaded', function() {
            var canvas = document.querySelector('.bg-canvas');
            for (var i = 0; i < 18; i++) {
                var p = document.createElement('div');
                p.className = 'particle';
                var size = Math.random() * 4 + 2;
                p.style.cssText = [
                    'width:' + size + 'px',
                    'height:' + size + 'px',
                    'left:' + Math.random() * 100 + '%',
                    'bottom:' + (Math.random() * 20 - 10) + '%',
                    '--dur:' + (Math.random() * 10 + 7) + 's',
                    '--delay:' + (Math.random() * 10) + 's',
                    'opacity:0'
                ].join(';');
                canvas.appendChild(p);
            }

            /* ══════════════════════════════════════
               PASSWORD TOGGLE
               ══════════════════════════════════════ */
            var pwdInput  = document.getElementById('password');
            var pwdToggle = document.getElementById('pwdToggle');
            var pwdIcon   = document.getElementById('pwdToggleIcon');

            if (pwdToggle) {
                pwdToggle.addEventListener('click', function() {
                    var shown = pwdInput.type === 'text';
                    pwdInput.type = shown ? 'password' : 'text';
                    pwdIcon.className = shown ? 'fa-solid fa-eye' : 'fa-solid fa-eye-slash';
                });
            }

            /* ══════════════════════════════════════
               BUTTON RIPPLE
               ══════════════════════════════════════ */
            var btn = document.getElementById('submitBtn');
            if (btn) {
                btn.addEventListener('click', function(e) {
                    var ripple = document.createElement('span');
                    ripple.className = 'btn-ripple';
                    var rect = btn.getBoundingClientRect();
                    var size = Math.max(rect.width, rect.height);
                    ripple.style.width = ripple.style.height = size + 'px';
                    ripple.style.left = (e.clientX - rect.left - size / 2) + 'px';
                    ripple.style.top  = (e.clientY - rect.top  - size / 2) + 'px';
                    btn.appendChild(ripple);
                    setTimeout(function() { ripple.remove(); }, 600);
                });
            }

            /* ══════════════════════════════════════
               FORM SUBMIT: LOADING OVERLAY
               ══════════════════════════════════════ */
            var form       = document.getElementById('loginForm');
            var loader     = document.getElementById('login-loader');
            var submitLbl  = document.getElementById('submitLabel');
            var submitIco  = document.getElementById('submitIcon');

            if (form) {
                form.addEventListener('submit', function(e) {
                    var username = (document.getElementById('username_id').value || '').toLowerCase();
                    var isAdmin  = username.includes('admin');

                    // Admin mode visual
                    if (isAdmin && !document.body.classList.contains('admin-mode')) {
                        e.preventDefault();
                        document.body.classList.add('admin-mode');
                        submitLbl.textContent = 'Authenticating Admin';
                        submitIco.className   = 'fa-solid fa-circle-notch fa-spin';
                        // Show full loader then submit
                        loader.classList.add('active');
                        document.querySelector('.loader-text').innerHTML =
                            'Verifying credentials<span class="loader-dots"></span>';
                        setTimeout(function() { form.submit(); }, 2000);
                        return;
                    }

                    // Normal submit — show loader
                    submitLbl.textContent = 'Signing in';
                    submitIco.className   = 'fa-solid fa-circle-notch fa-spin';
                    loader.classList.add('active');
                });
            }
        });
    </script>
</body>
</html>
