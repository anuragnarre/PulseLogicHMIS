@using System;
@using System.Collections.Generic;
@using System.Linq;
@using System.Text;
@using PulseLogicHMR.Security;

@{
    List<PulseLogicRoute> validRoutes = (List<PulseLogicRoute>)ViewData["validroutes"];
    RbacUser currUser = (RbacUser)ViewData["currentuser"];
    validRoutes = validRoutes.Where(r => r.DefaultShow != false && r.IsActive == true).ToList();
}

<style>
    /* ═══════════════════════════════════════════════════
       V2.0.1 FULL THEME ENGINE
       All three themes: light | dark | midnight
       Every element uses CSS variables — NO hardcoded colors
       ═══════════════════════════════════════════════════ */

    /* ── LIGHT (default) ── */
    :root,
    [data-theme="light"] {
        --bg-color:              #f3f4f6;
        --surface-color:         #ffffff;
        --surface-blur:          rgba(255,255,255,0.9);
        --surface-alt:           #f8fafc;
        --primary-color:         #0ea5e9;
        --primary-hover:         #0284c7;
        --primary-light:         #e0f2fe;
        --text-main:             #1f2937;
        --text-muted:            #6b7280;
        --text-on-primary:       #ffffff;
        --input-bg:              #f9fafb;
        --input-border:          #e5e7eb;
        --input-text:            #1f2937;
        --header-bg:             #0ea5e9;
        --header-text:           #ffffff;
        --sidebar-bg:            #1e293b;
        --sidebar-hover:         #334155;
        --sidebar-text:          #f8fafc;
        --sidebar-border:        #334155;
        --shadow-color:          rgba(0,0,0,0.06);
        --dropdown-bg:           #ffffff;
        --dropdown-text:         #1f2937;
        --dropdown-hover:        #f0f9ff;
        --dropdown-border:       #e5e7eb;
        --badge-bg:              #e0f2fe;
        --badge-text:            #0369a1;
        --table-header-bg:       #f1f5f9;
        --table-stripe-bg:       #f8fafc;
        --table-border:          #e5e7eb;
        --scrollbar-thumb:       #cbd5e1;
        --scrollbar-track:       #f1f5f9;
        /* Mirror aliases */
        --bg-app:                #f3f4f6;
        --bg-surface:            #ffffff;
        --bg-sidebar:            #1e293b;
        --text-primary:          #1f2937;
        --text-secondary:        #6b7280;
        --border-light:          #e5e7eb;
        --color-primary:         #0ea5e9;
        --color-primary-light:   #e0f2fe;
        --color-primary-hover:   #0284c7;
        --icon-btn-bg:           #f1f5f9;
        --icon-btn-border:       #e2e8f0;
        --version-badge-bg:      #f1f5f9;
        --version-badge-color:   #475569;
    }

    /* ── DARK (Cyan) ── */
    [data-theme="dark"] {
        --bg-color:              #0f172a;
        --surface-color:         #1e293b;
        --surface-blur:          rgba(30,41,59,0.8);
        --surface-alt:           #162032;
        --primary-color:         #06b6d4;
        --primary-hover:         #0891b2;
        --primary-light:         rgba(6,182,212,0.15);
        --text-main:             #f1f5f9;
        --text-muted:            #94a3b8;
        --text-on-primary:       #ffffff;
        --input-bg:              #0f172a;
        --input-border:          #334155;
        --input-text:            #f1f5f9;
        --header-bg:             #0c1526;
        --header-text:           #f1f5f9;
        --sidebar-bg:            #020617;
        --sidebar-hover:         #1e293b;
        --sidebar-text:          #e2e8f0;
        --sidebar-border:        #1e293b;
        --shadow-color:          rgba(0,0,0,0.4);
        --dropdown-bg:           #1e293b;
        --dropdown-text:         #f1f5f9;
        --dropdown-hover:        #334155;
        --dropdown-border:       #334155;
        --badge-bg:              rgba(6,182,212,0.2);
        --badge-text:            #67e8f9;
        --table-header-bg:       #162032;
        --table-stripe-bg:       #162032;
        --table-border:          #334155;
        --scrollbar-thumb:       #334155;
        --scrollbar-track:       #0f172a;
        /* Mirror aliases */
        --bg-app:                #0f172a;
        --bg-surface:            #1e293b;
        --bg-sidebar:            #020617;
        --text-primary:          #f1f5f9;
        --text-secondary:        #94a3b8;
        --border-light:          #334155;
        --color-primary:         #06b6d4;
        --color-primary-light:   rgba(6,182,212,0.15);
        --color-primary-hover:   #0891b2;
        --icon-btn-bg:           #1e293b;
        --icon-btn-border:       #334155;
        --version-badge-bg:      #1e293b;
        --version-badge-color:   #94a3b8;
    }

    /* ── MIDNIGHT (Purple) ── */
    [data-theme="midnight"] {
        --bg-color:              #09090b;
        --surface-color:         #18181b;
        --surface-blur:          rgba(24,24,27,0.9);
        --surface-alt:           #141417;
        --primary-color:         #a855f7;
        --primary-hover:         #9333ea;
        --primary-light:         rgba(168,85,247,0.15);
        --text-main:             #fafafa;
        --text-muted:            #a1a1aa;
        --text-on-primary:       #ffffff;
        --input-bg:              #09090b;
        --input-border:          #3f3f46;
        --input-text:            #fafafa;
        --header-bg:             #060607;
        --header-text:           #fafafa;
        --sidebar-bg:            #040407;
        --sidebar-hover:         #18181b;
        --sidebar-text:          #f4f4f5;
        --sidebar-border:        #18181b;
        --shadow-color:          rgba(0,0,0,0.6);
        --dropdown-bg:           #18181b;
        --dropdown-text:         #fafafa;
        --dropdown-hover:        #27272a;
        --dropdown-border:       #3f3f46;
        --badge-bg:              rgba(168,85,247,0.2);
        --badge-text:            #d8b4fe;
        --table-header-bg:       #141417;
        --table-stripe-bg:       #141417;
        --table-border:          #3f3f46;
        --scrollbar-thumb:       #3f3f46;
        --scrollbar-track:       #09090b;
        /* Mirror aliases */
        --bg-app:                #09090b;
        --bg-surface:            #18181b;
        --bg-sidebar:            #040407;
        --text-primary:          #fafafa;
        --text-secondary:        #a1a1aa;
        --border-light:          #3f3f46;
        --color-primary:         #a855f7;
        --color-primary-light:   rgba(168,85,247,0.15);
        --color-primary-hover:   #9333ea;
        --icon-btn-bg:           #18181b;
        --icon-btn-border:       #3f3f46;
        --version-badge-bg:      #18181b;
        --version-badge-color:   #a1a1aa;
    }

    /* ═══════════════════════════════════════════════════
       GLOBAL TRANSITIONS — smooth on every change
       ═══════════════════════════════════════════════════ */
    *, *::before, *::after {
        transition-property: background-color, color, border-color, box-shadow;
        transition-duration: 0.3s;
        transition-timing-function: ease;
    }
    /* Never animate transforms/positions (breaks animations) */
    [class*="animate"], [class*="fa-spin"], .spinner, .ecg-path {
        transition: none !important;
    }

    /* ═══════════════════════════════════════════════════
       BODY & PAGE WRAPPER
       ═══════════════════════════════════════════════════ */
    html, body,
    .page-container, .page-wrapper,
    .page-content-wrapper, .page-content,
    .page-content-bg-solid, .page-content-white {
        background-color: var(--bg-color) !important;
        color: var(--text-main) !important;
    }

    /* ═══════════════════════════════════════════════════
       HEADER
       ═══════════════════════════════════════════════════ */
    .page-header.navbar,
    .page-header.navbar .page-logo,
    .page-header-inner {
        background-color: var(--header-bg) !important;
        color: var(--header-text) !important;
        border-bottom-color: var(--input-border) !important;
    }
    /* ALL text directly in header */
    .page-header span,
    .page-header b,
    .page-header .username,
    .page-header a,
    .page-header i,
    .page-header .dropdown-toggle,
    .top-menu .nav > li > a {
        color: var(--header-text) !important;
    }

    /* ═══════════════════════════════════════════════════
       SIDEBAR
       ═══════════════════════════════════════════════════ */
    .page-sidebar-wrapper,
    .page-sidebar,
    .page-sidebar .navbar-collapse {
        background-color: var(--sidebar-bg) !important;
    }
    .page-sidebar .page-sidebar-menu > li > a {
        background-color: var(--sidebar-bg) !important;
        color: var(--sidebar-text) !important;
        border-top-color: var(--sidebar-border) !important;
    }
    .page-sidebar .page-sidebar-menu > li > a:hover,
    .page-sidebar .page-sidebar-menu > li > a.left-nav-active {
        background-color: var(--sidebar-hover) !important;
        color: #fff !important;
    }
    /* Sub-menu */
    .page-sidebar .page-sidebar-menu ul.sub-menu,
    .page-sidebar .page-sidebar-menu ul.sub-menu > li > a {
        background-color: var(--sidebar-hover) !important;
        color: var(--sidebar-text) !important;
    }
    .page-sidebar .page-sidebar-menu ul.sub-menu > li > a:hover {
        background-color: var(--primary-color) !important;
        color: #fff !important;
    }
    /* Sidebar span titles */
    .page-sidebar span.title,
    .page-sidebar span.selected,
    .page-sidebar b {
        color: var(--sidebar-text) !important;
    }
    /* Expand/collapse toggle */
    span.ad-sign:after {
        position: absolute;
        display: inline-block;
        content: '\2013';
        right: 5px;
        top: 11px;
        text-align: center;
        background: var(--sidebar-hover);
        z-index: 22;
        width: 24px;
        height: 24px;
        line-height: 20px;
        font-weight: bold;
        color: var(--sidebar-text);
        font-size: 20px;
        transition: transform .25s linear;
        -webkit-transition: -webkit-transform .25s linear;
    }
    span.ad-sign.collapsed:after {
        line-height: 24px !important;
        content: '+';
        -webkit-transform: rotate(90deg);
        transform: rotate(90deg);
    }
    span.ad-sign:after {
        -webkit-transform: rotate(180deg);
        transform: rotate(180deg);
    }
    .page-sidebar-menu-closed span.ad-sign { display: none; }
    ul.page-sidebar-menu > li { position: relative; }
    .page-sidebar .page-sidebar-menu > li > a {
        padding: 7px 15px 7px 8px;
    }
    .nav-schedule { background-image: url('/themes/theme-default/images/nav/schedule.PNG'); }

    /* ═══════════════════════════════════════════════════
       ALL TEXT ELEMENTS — complete coverage
       ═══════════════════════════════════════════════════ */
    h1, h2, h3, h4, h5, h6,
    p, span, label, b, strong, em, small,
    li, dt, dd, caption, figcaption,
    .title, .subtitle, .caption {
        color: var(--text-main);
    }
    /* Muted / helper text */
    .text-muted, small, .help-block, .form-text {
        color: var(--text-muted) !important;
    }
    /* Links */
    a:not(.btn):not(.nav-link):not(.dropdown-toggle) {
        color: var(--primary-color);
    }
    a:not(.btn):not(.nav-link):not(.dropdown-toggle):hover {
        color: var(--primary-hover);
    }

    /* ═══════════════════════════════════════════════════
       SURFACE CARDS & PANELS
       ═══════════════════════════════════════════════════ */
    .portlet, .portlet-body,
    .hpanel, .hpanel-body,
    .panel, .panel-body, .panel-footer,
    .panel-default,
    .modelbox-div,
    .page-bar, .action-bar,
    .doc-tab-content,
    .doc-pagecontent .page-bar,
    .card, .card-body, .card-footer {
        background-color: var(--surface-color) !important;
        color: var(--text-main) !important;
        border-color: var(--input-border) !important;
    }
    /* Panel headings */
    .portlet-title, .portlet-title .caption,
    .panel-heading, .panel-title,
    .hpanel .panel-heading {
        background-color: var(--surface-alt) !important;
        color: var(--text-main) !important;
        border-bottom-color: var(--input-border) !important;
    }
    /* Dark theme card shadow boost */
    [data-theme="dark"]  .portlet,
    [data-theme="dark"]  .panel,
    [data-theme="midnight"] .portlet,
    [data-theme="midnight"] .panel {
        box-shadow: 0 4px 16px -2px var(--shadow-color) !important;
    }

    /* ═══════════════════════════════════════════════════
       FORM CONTROLS — inputs, selects, textareas
       ═══════════════════════════════════════════════════ */
    input, input[type="text"], input[type="number"], input[type="email"],
    input[type="password"], input[type="search"], input[type="date"],
    input[type="time"], input[type="datetime-local"],
    select, textarea, .form-control {
        background-color: var(--input-bg) !important;
        color: var(--input-text) !important;
        border-color: var(--input-border) !important;
    }
    input::placeholder, textarea::placeholder { color: var(--text-muted) !important; opacity: 1; }
    input:focus, input[type="text"]:focus, input[type="number"]:focus,
    select:focus, textarea:focus, .form-control:focus {
        border-color: var(--primary-color) !important;
        box-shadow: 0 0 0 3px var(--primary-light) !important;
        outline: none !important;
    }
    /* Checkbox and radio labels */
    input[type="checkbox"] + label,
    input[type="radio"]    + label {
        color: var(--text-main) !important;
    }
    /* Input group addon */
    .input-group-addon {
        background-color: var(--surface-alt) !important;
        color: var(--text-main) !important;
        border-color: var(--input-border) !important;
    }

    /* ═══════════════════════════════════════════════════
       BUTTONS
       ═══════════════════════════════════════════════════ */
    .btn-primary, .primary-btn {
        background-color: var(--primary-color) !important;
        border-color: var(--primary-color) !important;
        color: var(--text-on-primary) !important;
    }
    .btn-primary:hover, .primary-btn:hover {
        background-color: var(--primary-hover) !important;
        border-color: var(--primary-hover) !important;
    }
    .btn-default, .btn-secondary {
        background-color: var(--surface-alt) !important;
        color: var(--text-main) !important;
        border-color: var(--input-border) !important;
    }
    .btn-default:hover, .btn-secondary:hover {
        background-color: var(--input-border) !important;
        color: var(--text-main) !important;
    }

    /* ═══════════════════════════════════════════════════
       TABLES
       ═══════════════════════════════════════════════════ */
    table, .table, .doc-tbl {
        background-color: var(--surface-color) !important;
        color: var(--text-main) !important;
        border-color: var(--table-border) !important;
    }
    th {
        background-color: var(--table-header-bg) !important;
        color: var(--text-main) !important;
        border-color: var(--table-border) !important;
    }
    td {
        color: var(--text-main) !important;
        border-color: var(--table-border) !important;
        background-color: transparent;
    }
    .table-striped > tbody > tr:nth-of-type(odd) > td {
        background-color: var(--table-stripe-bg) !important;
    }
    .table-hover > tbody > tr:hover > td {
        background-color: var(--primary-light) !important;
        color: var(--text-main) !important;
    }
    tr.row-selected > td {
        background-color: var(--primary-light) !important;
        border-left: 3px solid var(--primary-color) !important;
    }

    /* ═══════════════════════════════════════════════════
       DROPDOWNS (Bootstrap .dropdown-menu)
       ═══════════════════════════════════════════════════ */
    .dropdown-menu,
    .dropdown-menu-default,
    ul.dropdown-menu {
        background-color: var(--dropdown-bg) !important;
        border-color: var(--dropdown-border) !important;
        box-shadow: 0 8px 24px var(--shadow-color) !important;
    }
    .dropdown-menu > li > a,
    .dropdown-menu-default > li > a {
        color: var(--dropdown-text) !important;
        background-color: transparent !important;
    }
    .dropdown-menu > li > a:hover,
    .dropdown-menu-default > li > a:hover {
        background-color: var(--dropdown-hover) !important;
        color: var(--text-main) !important;
    }
    .dropdown-menu > li.divider,
    .dropdown-divider {
        background-color: var(--input-border) !important;
    }

    /* ═══════════════════════════════════════════════════
       MODALS
       ═══════════════════════════════════════════════════ */
    .modal-content {
        background-color: var(--surface-color) !important;
        color: var(--text-main) !important;
        border-color: var(--input-border) !important;
    }
    .modal-header {
        background-color: var(--surface-alt) !important;
        color: var(--text-main) !important;
        border-bottom-color: var(--input-border) !important;
    }
    .modal-footer {
        background-color: var(--surface-alt) !important;
        border-top-color: var(--input-border) !important;
    }
    .modal-title,
    .modal-header .close {
        color: var(--text-main) !important;
    }

    /* ═══════════════════════════════════════════════════
       TABS
       ═══════════════════════════════════════════════════ */
    .nav-tabs {
        border-bottom-color: var(--input-border) !important;
    }
    .nav-tabs > li > a {
        color: var(--text-muted) !important;
        background-color: transparent !important;
        border-color: transparent !important;
    }
    .nav-tabs > li.active > a,
    .nav-tabs > li > a:hover {
        color: var(--text-main) !important;
        background-color: var(--surface-color) !important;
        border-color: var(--input-border) var(--input-border) transparent !important;
    }
    .tab-content {
        background-color: var(--surface-color) !important;
        color: var(--text-main) !important;
        border-color: var(--input-border) !important;
    }

    /* ═══════════════════════════════════════════════════
       BREADCRUMBS & PAGE BAR
       ═══════════════════════════════════════════════════ */
    .page-bar {
        background-color: var(--surface-alt) !important;
    }
    .page-breadcrumb.breadcrumb {
        background-color: transparent !important;
    }
    .page-breadcrumb.breadcrumb li a,
    .page-breadcrumb.breadcrumb li,
    .page-breadcrumb.breadcrumb li span {
        color: var(--text-muted) !important;
    }
    .page-breadcrumb.breadcrumb li.active {
        color: var(--text-main) !important;
    }

    /* ═══════════════════════════════════════════════════
       BADGES
       ═══════════════════════════════════════════════════ */
    .badge, .label {
        background-color: var(--badge-bg) !important;
        color: var(--badge-text) !important;
    }
    .badge-success { background-color: #16a34a !important; color: #fff !important; }
    .badge-danger  { background-color: #dc2626 !important; color: #fff !important; }
    .badge-warning { background-color: #d97706 !important; color: #fff !important; }
    .badge-info    { background-color: var(--primary-color) !important; color: #fff !important; }

    /* ═══════════════════════════════════════════════════
       LOGO FILTER — invert for dark/midnight
       ═══════════════════════════════════════════════════ */
    .logo-default { transition: filter 0.3s ease; }
    [data-theme="light"]    .logo-default { filter: none !important; }
    [data-theme="dark"]     .logo-default { filter: brightness(0) invert(1) !important; }
    [data-theme="midnight"] .logo-default { filter: brightness(0) invert(1) !important; }

    /* ═══════════════════════════════════════════════════
       SCROLLBARS (webkit)
       ═══════════════════════════════════════════════════ */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: var(--scrollbar-track); }
    ::-webkit-scrollbar-thumb { background: var(--scrollbar-thumb); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--primary-color); }

    /* ═══════════════════════════════════════════════════
       THEME SWITCHER BUTTONS
       ═══════════════════════════════════════════════════ */
    .theme-selector {
        display: flex;
        gap: 0.5rem;
        background: rgba(255,255,255,0.1);
        padding: 0.4rem 0.6rem;
        border-radius: 20px;
        align-items: center;
        height: 100%;
        margin-top: 5px;
    }
    .theme-btn {
        width: 22px; height: 22px;
        border-radius: 50%;
        border: none;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .theme-btn:hover   { transform: scale(1.25); box-shadow: 0 0 8px rgba(255,255,255,0.4); }
    .theme-light       { background: #f3f4f6; border: 2px solid #cbd5e1; }
    .theme-dark        { background: #0f172a; border: 2px solid #06b6d4; }
    .theme-midnight    { background: #09090b; border: 2px solid #a855f7; }

    /* ═══════════════════════════════════════════════════
       HELP / ABOUT ICON — always visible on dark header
       ═══════════════════════════════════════════════════ */
    .help-about {
        color: var(--header-text) !important;
        font-size: 19px !important;
    }

    /* ═══════════════════════════════════════════════════
       TOOLTIP (version badge)
       ═══════════════════════════════════════════════════ */
    .tooltiptext {
        background: #eab308 !important;
        color: #000 !important;
    }
</style>

<!-- ═══════════════════════════════════════════════════════════
     PulseLogic HMIS v2.0.1 — Premium Shell Layout
     Single source of truth: Razor nav + Angular directives
     Full theme support: light | dark | midnight
     ═══════════════════════════════════════════════════════════ -->
<style>
    /* ── RESET OLD BOOTSTRAP LAYOUT completely ── */
    body { margin: 0 !important; padding: 0 !important; overflow: hidden; }

    /* ── APP ROOT ── */
    .pl2-shell {
        display: flex;
        flex-direction: column;
        height: 100vh;
        width: 100vw;
        overflow: hidden;
        background: var(--bg-color, #f3f4f6);
        color: var(--text-main, #1f2937);
        font-family: 'Inter', 'Quicksand', 'Open Sans', sans-serif;
    }

    /* ── HEADER ── */
    .pl2-header {
        height: 56px;
        min-height: 56px;
        display: flex;
        align-items: center;
        padding: 0 14px 0 0;
        background: var(--header-bg, #0ea5e9);
        color: var(--header-text, #fff);
        position: relative;
        z-index: 200;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        flex-shrink: 0;
        gap: 10px;
    }
    .pl2-logo-block {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0 16px;
        height: 100%;
        background: rgba(0,0,0,0.12);
