    <!-- ═══════════════════════════════════════════════
         PULSELOGIC v2.0.1 — THEME + SHELL JAVASCRIPT
         ═══════════════════════════════════════════════ -->
    <script>
        // ── Theme engine (runs before paint to avoid FOUC) ──
        function setTheme(theme) {
            document.documentElement.setAttribute('data-theme', theme);
            localStorage.setItem('pulselogic_theme', theme);
            window.dispatchEvent(new CustomEvent('pulselogic-theme-change', { detail: { theme } }));
        }
        (function() {
            var t = localStorage.getItem('pulselogic_theme') || 'dark';
            document.documentElement.setAttribute('data-theme', t);
        })();

        // ── Sidebar collapse ──
        function pl2ToggleSidebar() {
            var sidebar  = document.getElementById('pl2-sidebar');
            var icon     = document.getElementById('pl2-collapse-icon');
            if (!sidebar) return;
            var collapsed = sidebar.classList.toggle('collapsed');
            localStorage.setItem('pl2_sidebar_collapsed', collapsed ? '1' : '0');
            if (icon) {
                icon.className = collapsed ? 'fa fa-chevron-right' : 'fa fa-chevron-left';
            }
        }
        // Restore sidebar state
        (function() {
            if (localStorage.getItem('pl2_sidebar_collapsed') === '1') {
                document.addEventListener('DOMContentLoaded', function() {
                    var sb = document.getElementById('pl2-sidebar');
                    var ic = document.getElementById('pl2-collapse-icon');
                    if (sb) { sb.classList.add('collapsed'); }
                    if (ic) { ic.className = 'fa fa-chevron-right'; }
                });
            }
        })();

        // ── Sub-menu accordion ──
        function pl2ToggleSubnav(linkEl) {
            var item   = linkEl.parentElement;
            var subnav = item.querySelector('.pl2-subnav');
            var icon   = linkEl.querySelector('.pl2-sub-toggle');
            if (!subnav) return;
            var open = subnav.classList.toggle('open');
            if (icon) {
                icon.style.transform = open
                    ? 'translateY(-50%) rotate(180deg)'
                    : 'translateY(-50%) rotate(0deg)';
            }
        }

        // ── Loading screen: hide once Angular bootstraps ──
        (function() {
            function hideSplash() {
                var loader = document.getElementById('pl2-init-loader');
                var shell  = document.getElementById('pl2-shell');
                if (loader) { loader.classList.add('hidden'); setTimeout(function(){loader.remove();}, 500); }
                if (shell)  { shell.style.display = ''; }
            }
            // Angular fires app-root or router-outlet once ready.
            // Fallback: hide after 3s even if Angular doesn't fire.
            document.addEventListener('DOMContentLoaded', function() {
                var shell = document.getElementById('pl2-shell');
                if (shell) shell.style.display = 'flex';
                setTimeout(hideSplash, 1200);
            });
        })();

        // ── Keyboard shortcuts ──
        document.addEventListener('keydown', function(e) {
            if (e.altKey && e.key.toLowerCase() === 'm') {
                e.preventDefault();
                pl2ToggleSidebar();
            }
            if (e.altKey && e.key.toLowerCase() === 't') {
                e.preventDefault();
                var themes = ['light','dark','midnight'];
                var cur = document.documentElement.getAttribute('data-theme') || 'dark';
                var next = themes[(themes.indexOf(cur) + 1) % themes.length];
                setTheme(next);
            }
            if (e.key === '?') {
                var overlay = document.getElementById('pl-shortcut-overlay');
                if (overlay) overlay.style.display = overlay.style.display === 'flex' ? 'none' : 'flex';
            }
        });
        document.addEventListener('click', function(e) {
            if (e.target && e.target.id === 'pl-shortcut-close') {
                var overlay = document.getElementById('pl-shortcut-overlay');
                if (overlay) overlay.style.display = 'none';
            }
        });
    </script>

    <!-- PulseLogic UX Engine -->
    <script>
    (function() {
        'use strict';

        /* ══════════════════════════════════════════════
           PL NAMESPACE — global utilities for all modules
           ══════════════════════════════════════════════ */
        window.PL = window.PL || {};

        /* ──────────────────────────────────────────────
           TOAST ENGINE
           Usage: PL.toast('Record saved.', 'success')
                  PL.toast('Validation failed', 'error', 6000)
                  types: 'success' | 'error' | 'warning' | 'info'
           ────────────────────────────────────────────── */
        var TOAST_ICONS = {
            success: 'fa-check',
            error:   'fa-times',
            warning: 'fa-exclamation',
            info:    'fa-info'
        };

        var TOAST_TITLES = {
            success: 'Success',
            error:   'Error',
            warning: 'Warning',
            info:    'Info'
        };

        PL.toast = function(message, type, duration) {
            type     = type     || 'info';
            duration = duration || 4000;

            var container = document.getElementById('pl-toast-container');
            if (!container) return;

            var toast = document.createElement('div');
            toast.className = 'pl-toast pl-toast-' + type;
            toast.style.setProperty('--toast-dur', (duration / 1000) + 's');
            toast.setAttribute('role', 'alert');

            toast.innerHTML =
                '<div class="pl-toast-icon"><i class="fa ' + (TOAST_ICONS[type] || 'fa-info') + '"></i></div>' +
                '<div class="pl-toast-body">' +
                    '<div class="pl-toast-title">' + (TOAST_TITLES[type] || 'Info') + '</div>' +
                    '<div class="pl-toast-msg">' + message + '</div>' +
                '</div>' +
                '<button class="pl-toast-close" aria-label="Dismiss">&times;</button>';

            container.appendChild(toast);

            function dismiss() {
                toast.classList.add('dismissing');
                setTimeout(function() {
                    if (toast.parentNode) toast.parentNode.removeChild(toast);
                }, 280);
            }

            // Auto-dismiss
            var timer = setTimeout(dismiss, duration);

            // Manual dismiss (click anywhere on toast or X)
            toast.addEventListener('click', function() {
                clearTimeout(timer);
                dismiss();
            });
        };

        /* Expose for Angular components via CustomEvent */
        window.addEventListener('pl-toast', function(e) {
            if (e && e.detail) {
                PL.toast(e.detail.message, e.detail.type, e.detail.duration);
            }
        });

        /* ──────────────────────────────────────────────
           SAVE STATUS
           Usage: PL.setSaveStatus('unsaved')
                  PL.setSaveStatus('saving')
                  PL.setSaveStatus('saved')
           ────────────────────────────────────────────── */
        var SAVE_LABELS = {
            unsaved: 'Unsaved changes',
            saving:  'Saving\u2026',
            saved:   'All saved \u2713',
            idle:    ''
        };

        PL.setSaveStatus = function(state) {
            var el   = document.getElementById('pl-save-status');
            var txt  = document.getElementById('pl-save-status-text');
            if (!el || !txt) return;

            el.style.display = (state === 'idle') ? 'none' : 'inline-flex';
            el.className = '';
            if (state && state !== 'idle') {
                el.classList.add('status-' + state);
            }
            txt.textContent = SAVE_LABELS[state] || '';
        };

        window.addEventListener('pl-save-status', function(e) {
            if (e && e.detail) PL.setSaveStatus(e.detail.state);
        });

        /* ──────────────────────────────────────────────
           KEYBOARD SHORTCUT OVERLAY
           ────────────────────────────────────────────── */
        function openShortcutOverlay() {
            var ov = document.getElementById('pl-shortcut-overlay');
            if (ov) ov.classList.add('active');
        }

        function closeShortcutOverlay() {
            var ov = document.getElementById('pl-shortcut-overlay');
            if (ov) ov.classList.remove('active');
        }

        document.addEventListener('DOMContentLoaded', function() {

            /* Shortcut button */
            var shortcutBtn = document.getElementById('pl-shortcut-btn');
            if (shortcutBtn) {
                shortcutBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    openShortcutOverlay();
                });
            }

            /* Close button inside overlay */
            var closeBtn = document.getElementById('pl-shortcut-close');
            if (closeBtn) {
                closeBtn.addEventListener('click', closeShortcutOverlay);
            }

            /* Click outside panel to close */
            var overlay = document.getElementById('pl-shortcut-overlay');
            if (overlay) {
                overlay.addEventListener('click', function(e) {
                    if (e.target === overlay) closeShortcutOverlay();
                });
            }

            /* Move save status badge into header if header exists */
            var saveStatus = document.getElementById('pl-save-status');
            var headerInner = document.querySelector('.page-header-inner') ||
                              document.querySelector('.modern-header-actions') ||
                              document.querySelector('.top-menu ul.nav');
            if (saveStatus && headerInner) {
                var li = document.createElement('li');
                li.style.cssText = 'display:flex;align-items:center;padding:0 10px;';
                li.appendChild(saveStatus);
                saveStatus.style.display = 'none';
                headerInner.insertBefore(li, headerInner.firstChild);
            }

            /* ─────────────────────────────────────────
               GLOBAL KEYBOARD SHORTCUT HANDLER
               ───────────────────────────────────────── */
            document.addEventListener('keydown', function(e) {
                var tag     = (document.activeElement || {}).tagName || '';
                var isInput = (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT');

                /* ? — shortcut help (only when not typing) */
                if (e.key === '?' && !isInput && !e.ctrlKey && !e.altKey) {
                    e.preventDefault();
                    openShortcutOverlay();
                    return;
                }

                /* Esc — close shortcut overlay first, else broadcast cancel */
                if (e.key === 'Escape') {
                    var ov = document.getElementById('pl-shortcut-overlay');
                    if (ov && ov.classList.contains('active')) {
                        closeShortcutOverlay();
                    } else {
                        window.dispatchEvent(new CustomEvent('pl-cancel', { bubbles: true }));
                    }
                    return;
                }

                /* Ctrl+S — save */
                if (e.ctrlKey && !e.altKey && (e.key === 's' || e.key === 'S')) {
                    e.preventDefault();
                    PL.setSaveStatus('saving');
                    window.dispatchEvent(new CustomEvent('pl-save', { bubbles: true }));
                    return;
                }

                /* Ctrl+N — new record */
                if (e.ctrlKey && !e.altKey && (e.key === 'n' || e.key === 'N')) {
                    e.preventDefault();
                    window.dispatchEvent(new CustomEvent('pl-new', { bubbles: true }));
                    return;
                }

                /* Ctrl+F — focus search/filter */
                if (e.ctrlKey && !e.altKey && (e.key === 'f' || e.key === 'F')) {
                    e.preventDefault();
                    /* Try to focus any visible quick-search or searchtbx */
                    var search = document.querySelector('.pl-quick-search input:not([disabled])') ||
                                 document.querySelector('.searchtbx:not([disabled])') ||
                                 document.querySelector('input[placeholder*="earch"]:not([disabled])');
                    if (search) {
                        search.focus();
                        search.select();
                    }
                    window.dispatchEvent(new CustomEvent('pl-search-focus', { bubbles: true }));
                    return;
                }

                /* F2 — edit row */
                if (e.key === 'F2' && !isInput) {
                    e.preventDefault();
                    window.dispatchEvent(new CustomEvent('pl-edit-row', { bubbles: true }));
                    return;
                }

                /* Alt+P — print */
                if (e.altKey && !e.ctrlKey && (e.key === 'p' || e.key === 'P')) {
                    e.preventDefault();
                    window.dispatchEvent(new CustomEvent('pl-print', { bubbles: true }));
                    return;
                }

                /* Alt+H — home/dashboard */
                if (e.altKey && !e.ctrlKey && (e.key === 'h' || e.key === 'H')) {
                    e.preventDefault();
                    window.dispatchEvent(new CustomEvent('pl-home', { bubbles: true }));
                    return;
                }

                /* Alt+M — toggle sidebar (works with new Angular sidebar) */
                if (e.altKey && !e.ctrlKey && (e.key === 'm' || e.key === 'M')) {
                    e.preventDefault();
                    // Try the new pl-sidebar-toggle button first (v2.0.1 layout)
                    var newToggler = document.querySelector('.pl-sidebar-toggle');
                    if (newToggler) {
                        newToggler.click();
                    } else {
                        // Fallback: old Bootstrap sidebar toggler
                        var oldToggler = document.querySelector('.menu-toggler.sidebar-toggler');
                        if (oldToggler) oldToggler.click();
                    }
                    window.dispatchEvent(new CustomEvent('pl-toggle-sidebar', { bubbles: true }));
                    return;
                }

                /* Alt+T — cycle theme */
                if (e.altKey && !e.ctrlKey && (e.key === 't' || e.key === 'T')) {
                    e.preventDefault();
                    var themes     = ['light', 'dark', 'midnight'];
                    var current    = document.documentElement.getAttribute('data-theme') || 'dark';
                    var nextTheme  = themes[(themes.indexOf(current) + 1) % themes.length];
                    if (typeof setTheme === 'function') setTheme(nextTheme);
                    PL.toast('Theme: ' + nextTheme.charAt(0).toUpperCase() + nextTheme.slice(1), 'info', 2000);
                    return;
                }
            });

            /* ─────────────────────────────────────────
               UNSAVED CHANGES DETECTION
               Marks any form dirty when an input changes
               Angular modules can call PL.setSaveStatus to override
               ───────────────────────────────────────── */
            var isDirty = false;

            document.addEventListener('input', function(e) {
                var tag = (e.target || {}).tagName || '';
                if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') {
                    if (!isDirty) {
                        isDirty = true;
                        PL.setSaveStatus('unsaved');
                    }
                }
            }, true);

            /* Clear dirty on pl-save or pl-cancel */
            window.addEventListener('pl-save', function() {
                isDirty = false;
                /* Status updated to 'saved' after a short delay (simulating async) */
                setTimeout(function() { PL.setSaveStatus('saved'); }, 1200);
                setTimeout(function() { PL.setSaveStatus('idle');  }, 3500);
            });

            window.addEventListener('pl-cancel', function() {
                isDirty = false;
                PL.setSaveStatus('idle');
            });

            /* Warn on tab close if dirty */
            window.addEventListener('beforeunload', function(e) {
                if (isDirty) {
                    e.preventDefault();
                    e.returnValue = 'You have unsaved changes. Are you sure you want to leave?';
                }
            });

            /* ─────────────────────────────────────────
               TABLE ROW KEYBOARD SELECTION
               Click or arrow keys to navigate rows;
               press Enter / F2 to fire pl-edit-row with rowData
               ───────────────────────────────────────── */
            document.addEventListener('click', function(e) {
                var row = e.target && e.target.closest('tr');
                if (!row || !row.parentElement || row.parentElement.tagName !== 'TBODY') return;

                /* Deselect previously selected row in same table */
                var table = row.closest('table');
                if (table) {
                    table.querySelectorAll('tr.row-selected').forEach(function(r) {
                        r.classList.remove('row-selected');
                    });
                }
                row.classList.add('row-selected');
            });

        }); /* end DOMContentLoaded */

    })();
    </script>
</body>
