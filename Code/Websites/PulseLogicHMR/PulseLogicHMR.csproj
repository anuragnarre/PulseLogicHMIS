    <PackageReference Include="EPPlus" Version="4.1.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="2.7.2" />
    <PackageReference Include="Audit.EntityFramework.Core" Version="21.1.1" />
    <PackageReference Include="Audit.NET" Version="21.1.1" />
    <PackageReference Include="Audit.NET.SqlServer" Version="21.1.1" />
    <PackageReference Include="Audit.WebApi.Core" Version="21.1.1" />
