    <!-- V2.0 Theme Engine Variables & Styles -->
    <style type="text/css">
        :root {
            --bg-color: #f3f4f6;
            --surface-color: #ffffff;
            --surface-blur: rgba(255, 255, 255, 0.85);
            --primary-color: #0ea5e9;
            --primary-hover: #0284c7;
            --text-main: #1f2937;
            --text-muted: #6b7280;
            --input-bg: #f9fafb;
            --input-border: #e5e7eb;
            --header-bg: #0773bc;
            --sidebar-bg: #0773bc;
            --sidebar-hover: #3e96f1;
        }

        [data-theme="dark"] {
            --bg-color: #0f172a;
            --surface-color: #1e293b;
            --surface-blur: rgba(30, 41, 59, 0.7);
            --primary-color: #06b6d4;
            --primary-hover: #0891b2;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --input-bg: #0f172a;
            --input-border: #334155;
            --header-bg: #0f172a;
            --sidebar-bg: #1e293b;
            --sidebar-hover: #334155;
        }

        [data-theme="warm"] {
            --bg-color: #fcf6ec;
            --surface-color: #ffffff;
            --surface-blur: rgba(255, 255, 255, 0.85);
            --primary-color: #d97706;
            --primary-hover: #b45309;
            --text-main: #451a03;
            --text-muted: #78350f;
            --input-bg: #fffbf7;
            --input-border: #f59e0b;
            --header-bg: #76323f;
            --sidebar-bg: #f5ebe0;
            --sidebar-hover: #e3d5ca;
        }

        .theme-selector {
            display: flex;
            gap: 6px;
            background: rgba(255, 255, 255, 0.15);
            padding: 4px 8px;
            border-radius: 20px;
            align-items: center;
            height: auto;
            border: 1px solid rgba(255, 255, 255, 0.25);
        }

        .theme-btn {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            border: 2px solid transparent;
            cursor: pointer;
            transition: all 0.2s ease;
            outline: none;
        }
        .theme-btn:hover { transform: scale(1.2); }
        .theme-light { background: #f3f4f6; border-color: #ffffff; }
        .theme-dark { background: #06b6d4; border-color: #ffffff; }
        .theme-warm { background: #d97706; border-color: #ffffff; }

        /* Dynamic Theme Overrides */
        .page-header.navbar {
            background-color: var(--header-bg) !important;
            transition: background-color 0.4s ease;
        }
        .page-header.navbar .page-logo {
            background: var(--header-bg) !important;
            transition: background 0.4s ease;
        }
        .page-container {
            background: var(--bg-color) !important;
            transition: background-color 0.4s ease;
        }
        .page-sidebar-wrapper, .page-sidebar {
            background-color: var(--sidebar-bg) !important;
            transition: background-color 0.4s ease;
        }
        .page-sidebar .page-sidebar-menu > li > a {
            background-color: var(--sidebar-bg) !important;
            color: var(--text-main) !important;
            transition: all 0.3s ease;
        }
        .page-sidebar .page-sidebar-menu > li > a.left-nav-active,
        .page-sidebar .page-sidebar-menu > li > a:hover {
            background-color: var(--sidebar-hover) !important;
            color: #fff !important;
        }
        body, .page-content-bg-solid, .page-content-white, .page-content {
            background-color: var(--bg-color) !important;
            color: var(--text-main) !important;
            transition: background-color 0.4s ease, color 0.4s ease;
        }

        /* Card panels and content wrappers */
        .portlet, .hpanel, .panel, .panel-body, .modelbox-div, .page-bar, .action-bar, .doc-tab-content, .doc-pagecontent .page-bar {
            background-color: var(--surface-color) !important;
            color: var(--text-main) !important;
            border-color: var(--input-border) !important;
            transition: background-color 0.4s ease, color 0.4s ease, border-color 0.4s ease;
        }
        [data-theme="dark"] .portlet, [data-theme="dark"] .hpanel, [data-theme="dark"] .panel,
        [data-theme="warm"] .portlet, [data-theme="warm"] .hpanel, [data-theme="warm"] .panel {
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.5), 0 2px 4px -2px rgb(0 0 0 / 0.5) !important;
        }

        /* Typography and general text overrides inside themes */
        [data-theme="dark"] h1, [data-theme="dark"] h2, [data-theme="dark"] h3, [data-theme="dark"] h4, [data-theme="dark"] h5, [data-theme="dark"] h6, [data-theme="dark"] p, [data-theme="dark"] span, [data-theme="dark"] label, [data-theme="dark"] th, [data-theme="dark"] td, [data-theme="dark"] div:not(.logo-default),
        [data-theme="warm"] h1, [data-theme="warm"] h2, [data-theme="warm"] h3, [data-theme="warm"] h4, [data-theme="warm"] h5, [data-theme="warm"] h6, [data-theme="warm"] p, [data-theme="warm"] span, [data-theme="warm"] label, [data-theme="warm"] th, [data-theme="warm"] td, [data-theme="warm"] div:not(.logo-default) {
            color: var(--text-main) !important;
        }
        [data-theme="dark"] a:not(.btn), [data-theme="warm"] a:not(.btn) {
            color: var(--primary-color) !important;
        }

        /* Overriding form fields, inputs, selects, textareas */
        input[type="text"], input[type="number"], input[type="email"], select, textarea, .form-control {
            background-color: var(--input-bg) !important;
            color: var(--text-main) !important;
            border-color: var(--input-border) !important;
            transition: all 0.3s ease;
        }
        input[type="text"]:focus, input[type="number"]:focus, input[type="email"]:focus, select:focus, textarea:focus, .form-control:focus {
            border-color: var(--primary-color) !important;
            outline: none;
        }

        /* Buttons */
        .btn-primary, .primary-btn, .btn-success, .btn-green {
            background-color: var(--primary-color) !important;
            border-color: var(--primary-color) !important;
            color: #fff !important;
            transition: all 0.3s ease;
        }
        .btn-primary:hover, .primary-btn:hover, .btn-success:hover, .btn-green:hover {
            background-color: var(--primary-hover) !important;
            border-color: var(--primary-hover) !important;
        }

        /* Tables */
        [data-theme="dark"] .table, [data-theme="dark"] .table-striped, [data-theme="dark"] th, [data-theme="dark"] td,
        [data-theme="warm"] .table, [data-theme="warm"] .table-striped, [data-theme="warm"] th, [data-theme="warm"] td {
            background-color: var(--surface-color) !important;
            border-color: var(--input-border) !important;
            color: var(--text-main) !important;
        }
        [data-theme="dark"] .doc-tbl th, [data-theme="warm"] .doc-tbl th {
            background-color: var(--input-border) !important;
        }

        /* Dynamic Logo Styling */
        [data-theme="light"] .logo-text { color: white !important; }
        [data-theme="dark"] .logo-text { color: var(--text-main) !important; }
        [data-theme="warm"] .logo-text { color: var(--text-main) !important; }

        /* Global Navigation Toggle */
        body.hide-horizontal-nav .fixed-top-bar,
        body.hide-horizontal-nav .fixed-subnavtab {
            display: none !important;
        }
    </style>

    <!-- Theme Engine JS -->
    <script>
        function setTheme(theme) {
            document.documentElement.setAttribute('data-theme', theme);
            localStorage.setItem('pulselogic_theme', theme);

            // Toggle logo displays
            document.querySelectorAll('.logo-light, .logo-dark, .logo-warm').forEach(function(el) {
                el.style.display = 'none';
            });
            var activeLogo = document.querySelector('.logo-' + theme);
            if (activeLogo) activeLogo.style.display = 'block';
        }

        // Global Horizontal Nav System
        window.toggleHorizontalNav = function() {
            var body = document.body;
            var isHidden = body.classList.toggle('hide-horizontal-nav');
            localStorage.setItem('pulselogic_hide_nav', isHidden ? 'true' : 'false');
        };

        // Event delegation for theme dropdown and nav toggle (works for dynamically loaded Angular HTML)
        document.addEventListener('click', function(e) {
            // Nav toggle check
            var navToggleTarget = e.target.closest ? e.target.closest('#app-nav-toggle-btn') : null;
            if (navToggleTarget) {
                window.toggleHorizontalNav();
                return;
            }

            var target = e.target.closest ? e.target.closest('[data-theme-action]') : null;
            var dd = document.getElementById('app-theme-dropdown');
            var toggleBtn = document.getElementById('app-theme-toggle-btn');

            if (target) {
                var action = target.getAttribute('data-theme-action');
                if (action === 'toggle') {
                    if (dd) dd.style.display = dd.style.display === 'none' ? 'block' : 'none';
                    return;
                }
                if (action === 'apply') {
                    var themeName = target.getAttribute('data-theme-name');
                    if (themeName) {
                        setTheme(themeName);
                    }
                    if (dd) dd.style.display = 'none';
                    return;
                }
            }

            // Close dropdown on outside click
            if (dd && toggleBtn && !toggleBtn.contains(e.target) && !dd.contains(e.target)) {
                dd.style.display = 'none';
            }
        });

        // Apply saved theme immediately
        const savedTheme = localStorage.getItem('pulselogic_theme') || 'light';
        setTheme(savedTheme);

        // Apply saved nav state immediately
        document.addEventListener('DOMContentLoaded', function() {
            var hideNav = localStorage.getItem('pulselogic_hide_nav');
            if (hideNav === 'true') {
                document.body.classList.add('hide-horizontal-nav');
            }
        });
    </script>
</head>


